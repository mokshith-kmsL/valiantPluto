# ── StockSense environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in values before running locally.
#
#   cp .env.example .env
#
# If using docker-compose these are already set in docker-compose.yml —
# you only need .env when running the Node process directly (npm run dev).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://stocksense:stocksense_dev@localhost:5432/stocksense

# Server port
PORT=3000

# Node environment (development | test | production)
NODE_ENV=development
